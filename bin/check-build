#!/usr/bin/env ruby
# Checks the Parklife output in ./build: the main pages exist, and every
# /assets/ and /vite/ file referenced by any page exists.
require 'pathname'

build = Pathname.new(File.expand_path('../build', __dir__))
abort "No build directory; run bin/parklife build first" unless build.directory?

errors = []
%w[index.html about.html requests.html sitemap.xml sitemaps/static.xml search.html 404.html CNAME pagefind/pagefind.js].each do |path|
  errors << "Missing #{path}" unless build.join(path).file?
end

pages = build.glob('**/*.html')
errors << "Only #{pages.size} pages built" if pages.size < 10

assets = pages.flat_map { |page| page.read.scan(%r{"(/(?:assets|vite)/[^"?#]+)"}).flatten }.uniq
errors << 'No asset references found' if assets.empty?
assets.each { |asset| errors << "Missing asset #{asset}" unless build.join(asset.delete_prefix('/')).file? }

if errors.any?
  warn errors.join("\n")
  exit 1
end
puts "Build OK: #{pages.size} pages, #{assets.size} assets referenced"
