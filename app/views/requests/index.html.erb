<% provide(:meta_title) { "Open311 Status - All Service Requests" } %>

<%= render 'cities/service_requests', service_requests: @service_requests %>

<nav>
  <ul class="pagination justify-content-center">
    <% if @page > 1 %>
      <li class="page-item">
        <a class="page-link" href="<%= @page == 2 ? requests_path : requests_page_path(@page - 1) %>">
          <span aria-hidden="true">&larr;</span>
          Newer requests
        </a>
      </li>
    <% end %>
    <% if @page < @total_pages %>
      <li class="page-item">
        <a class="page-link" href="<%= requests_page_path(@page + 1) %>">
          Older requests
          <span aria-hidden="true">&rarr;</span>
        </a>
      </li>
    <% end %>
  </ul>
</nav>
